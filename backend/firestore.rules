rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: Check user ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public Profiles: Read by any authenticated user, write only by profile owner
    match /public_profiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(userId);
    }

    // Friend Requests: Mutual discovery & management
    // Document ID pattern: {senderUid}_{receiverUid}
    match /friend_requests/{requestId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && (
        resource.data.receiverId == request.auth.uid || 
        resource.data.senderId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.receiverId == request.auth.uid || 
        resource.data.senderId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.receiverId == request.auth.uid || 
        resource.data.senderId == request.auth.uid
      );
    }

    // 1-on-1 Chat Threads & Subcollection Messages
    match /chats/{chatId} {
      // Participant check for parent chat document
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants
      );
      allow create: if isAuthenticated() && (
        request.auth.uid in request.resource.data.participants
      );
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participants
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid in resource.data.participants
      );
      
      // Messages inside chat (participant authorization enforced from parent chat)
      match /messages/{messageId} {
        function isParticipant() {
          return isAuthenticated() && (
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          );
        }

        allow read: if isParticipant();
        allow create: if isParticipant() && request.resource.data.senderId == request.auth.uid;
        // Update permitted for editing (by sender) or marking read / cleared-for-me (by participants)
        allow update: if isParticipant();
        // Delete for everyone permitted strictly by message author
        allow delete: if isParticipant() && resource.data.senderId == request.auth.uid;
      }
    }

    // User Data Sovereignty (Vaults, Targets, Transactions, Local Settings, FCM Tokens)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write, delete: if isOwner(userId);
      }
    }
  }
}
