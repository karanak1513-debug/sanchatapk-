rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: Check user ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public Profiles: Read by any authenticated user, write only by profile owner
    match /public_profiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(userId);
    }

    // Friend Requests: Mutual discovery & management
    // Document ID pattern: {senderUid}_{receiverUid}
    match /friend_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.receiverId == request.auth.uid || 
        resource.data.senderId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.receiverId == request.auth.uid || 
        resource.data.senderId == request.auth.uid
      );
    }

    // 1-on-1 Chat Threads & Subcollection Messages
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();
      
      // Messages inside chat (Fixes "Delete for Everyone" permission denied)
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated() && resource.data.senderId == request.auth.uid;
        // Permit hard deletion by sender for "Delete for Everyone"
        allow delete: if isAuthenticated();
      }
    }

    // User Data Sovereignty (Vaults, Targets, Transactions, Local Settings)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write, delete: if isOwner(userId);
      }
    }
  }
}
