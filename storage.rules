rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User Avatars: Public read for chats, write strictly by owner (with null check for deletes)
    match /users/{userId}/avatar.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && (request.resource == null || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }

    // Encrypted JSON Backups: Strict private access
    match /users/{userId}/backups/{fileName} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
