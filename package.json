{
  "name": "sanchay-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Sanchay Wealth System — Frontend (Next.js), Backend (Firebase & Cloud Functions), and Mobile (Flutter)",
  "workspaces": [
    "frontend",
    "backend/functions"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "start:frontend": "npm --prefix frontend run start",
    "lint:frontend": "npm --prefix frontend run lint",
    "serve:backend": "node backend/serve_sanchay.js",
    "serve:apk": "node backend/serve_apk.js",
    "deploy:functions": "firebase deploy --only functions --config backend/firebase.json",
    "deploy:rules": "firebase deploy --only firestore:rules,storage --config backend/firebase.json"
  }
}
